# ===== MiniMax 配音（也可用界面「设置」配置，界面优先）=====
# MiniMax TTS API Key（绝不提交真实值）
MINIMAX_API_KEY=
# 个人克隆音色 ID 或预设音色 ID
MINIMAX_VOICE_ID=
# TTS 接口基础地址（OpenAI 兼容代理或官方地址）
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# TTS 模型
MINIMAX_MODEL=minimax-speech-2.8-hd

# ===== 说明 =====
# 大模型 Provider（API base / key / 各阶段模型选择）与飞书摄取凭据
# 均在前端「设置」界面配置，保存在 backend/data/settings.json（已被 .gitignore 排除）。
